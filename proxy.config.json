{
  "/assets/images/*": {
    "target": "http://localhost:3333/images",
    "secure": false,
    "pathRewrite": {
      "^/assets/images": "/"
    }
  },
  "/assets/data/*": {
    "target": "http://localhost:3333/data",
    "secure": false,
    "pathRewrite": {
      "^/assets/data": "/"
    }
  }
}
