{
  "compilerOptions": {
    "types": ["node"],
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2017",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@kalila-edition/common-ui": ["libs/common-ui/src/index.ts"],
      "@kalila-edition/common-util": ["libs/common-util/src/index.ts"],
      "@kalila-edition/dissemination-history": [
        "libs/dissemination-history/src/index.ts"
      ],
      "@kalila-edition/section-collations": [
        "libs/section-collations/src/index.ts"
      ],
      "@kalila-edition/section-help": ["libs/section-help/src/index.ts"],
      "@kalila-edition/section-manuscript-description": [
        "libs/section-manuscript-description/src/index.ts"
      ],
      "@kalila-edition/section-manuscripts": [
        "libs/section-manuscripts/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
