{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "kd",
  "sourceRoot": "apps/web/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:webpack-browser",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/web/browser",
        "index": "apps/web/src/index.html",
        "main": "apps/web/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/web/tsconfig.app.json",
        "stylePreprocessorOptions": {
          "includePaths": ["sass"]
        },
        "assets": [
          "apps/web/src/favicon.ico",
          "apps/web/src/assets",
          "apps/web/src/manifest.webmanifest"
        ],
        "styles": [
        "apps/web/src/styles.scss",
        "apps/web/src/catView/lib/catview/catview.css",
        "apps/web/src/catView/lib/lera.css"  ],
        "scripts": [
                   "apps/web/src/catView/lib/d3/d3.min.js",
                   "apps/web/src/catView/lib/catview/catview.js",
                   "apps/web/src/catView/data/catview.js",
                   "apps/web/src/catView/lib/jquery-1.11.3.min.js",
                   "apps/web/src/catView/lib/lera.js",
                   "apps/web/src/mcLeraCatView/lib/lera.js",
                   "apps/web/src/mcLeraCatView/data/catview.js"
                 ],
        "serviceWorker": true,
        "ngswConfigPath": "apps/web/ngsw-config.json",
        "webWorkerTsConfig": "apps/web/tsconfig.worker.json",
        "allowedCommonJsDependencies": ["konva"],
        "customWebpackConfig": {
          "path": "apps/web/client.webpack.config.js"
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "4mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "10kb",
              "maximumError": "20kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/web/src/app/environment.ts",
              "with": "apps/web/src/app/environment.prod.ts"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "options": {
        "proxyConfig": "proxy.config.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "web:build:production"
        },
        "development": {
          "buildTarget": "web:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "web:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/web/jest.config.ts",
        "webWorkerTsConfig": "apps/web/tsconfig.worker.json"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "web:build"
      }
    },
    "server": {
      "dependsOn": ["build"],
      "executor": "@nx/angular:webpack-server",
      "outputPath": "dist/apps/web/server",
      "main": "apps/web/server.ts",
      "tsConfig": "apps/web/tsconfig.server.json",
      "customWebpackConfig": {
        "path": "apps/web/server.webpack.config.js"
      },
      "configurations": {
        "production": {
          "outputHashing": "media",
          "outputPath": "dist/apps/web/server",
          "main": "apps/web/server.ts",
          "tsConfig": "apps/web/tsconfig.server.json",
          "customWebpackConfig": {
            "path": "apps/web/server.webpack.config.js"
          },
          "fileReplacements": [
            {
              "replace": "apps/web/src/app/environment.ts",
              "with": "apps/web/src/app/environment.prod.ts"
            }
          ]
        },
        "development": {
          "outputPath": "dist/apps/web/server",
          "main": "apps/web/server.ts",
          "tsConfig": "apps/web/tsconfig.server.json",
          "buildOptimizer": false,
          "optimization": false,
          "sourceMap": true,
          "extractLicenses": false,
          "vendorChunk": true,
          "customWebpackConfig": {
            "path": "apps/web/server.webpack.config.js"
          }
        }
      },
      "defaultConfiguration": "production"
    },
    "serve-ssr": {
      "executor": "@angular-devkit/build-angular:ssr-dev-server",
      "configurations": {
        "development": {
          "browserTarget": "web:build:development",
          "serverTarget": "web:server:development"
        },
        "options": {
          "proxyConfig": "proxy.config.json"
        },
        "production": {
          "browserTarget": "web:build:production",
          "serverTarget": "web:server:production"
        }
      },
      "defaultConfiguration": "development"
    },
    "prerender": {
      "executor": "@angular-devkit/build-angular:prerender",
      "options": {
        "routesFile": "routes.txt"
      },
      "configurations": {
        "development": {
          "browserTarget": "web:build:development",
          "serverTarget": "web:server:development"
        },
        "production": {
          "browserTarget": "web:build:production",
          "serverTarget": "web:server:production"
        }
      },
      "defaultConfiguration": "production"
    },
    "build-ssr": {
      "executor": "@angular-devkit/build-angular:prerender",

      "configurations": {
        "development": {
          "browserTarget": "web:build:development",
          "serverTarget": "web:server:development"
        },
        "production": {
          "browserTarget": "web:build:production",
          "serverTarget": "web:server:production"
        }
      },
      "defaultConfiguration": "production"
    }
  }
}
